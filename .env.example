# Google AI Studio 무료 티어 키. 브라우저에 노출하지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Kakao Developers REST API 키. Daum 검색 기반 트렌드 기능에 사용합니다.
KAKAO_REST_API_KEY=

# 선택 사항: Cloudflare Workers Free 계정만 사용하세요.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# 결제 방지 안전장치 — true로 바꾸지 마세요.
FREE_ONLY=true
ALLOW_PAID_MODELS=false
MAX_DAILY_CLOUDFLARE_NEURONS=9000
PROJECT_PAID_BUDGET_KRW=0
PROJECTS_DIR=./data/projects

# Cloudflare Pages에서 별도 API Worker를 사용할 때만 설정합니다.
VITE_API_BASE_URL=
